{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PCP Central",
  "mainBinaryName": "pcp-central",
  "version": "../package.json",
  "identifier": "com.pcp.central",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PCP Sublimação — Central",
        "width": 1320,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFERTc5NEQwMUU3RDJENjgKUldSb0xYMGUwSlRuSGJsbE4xWlg0bm9kRURYcXpObHdiSjg1aGUxUWdyUmN1dW1vcm8zOTNFYmoK",
      "endpoints": [
        "https://github.com/mrmateussiilva/pcp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "PCP Sublimação",
    "copyright": "© PCP Sublimação",
    "category": "Productivity",
    "shortDescription": "Central de produção PCP (sublimação)",
    "longDescription": "PCP Central — ferramentas de pré-impressão, produção, expedição e comunicação para sublimação em uma única aplicação desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
